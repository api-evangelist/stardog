{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stardog HTTP Checkpoints API",
    "version": "12.0.3"
  },
  "items": [
    {
      "info": {
        "name": "Checkpoints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Restore checkpoints",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://localhost:5820/admin/checkpoint/:db/:checkpoint",
            "params": [
              {
                "name": "db",
                "value": "myDb",
                "type": "path",
                "description": "Database name"
              },
              {
                "name": "checkpoint",
                "value": "",
                "type": "path",
                "description": "the name of the checkpoint"
              }
            ]
          },
          "docs": "Restore checkpoints"
        },
        {
          "info": {
            "name": "List checkpoints",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:5820/admin/checkpoint/:db",
            "params": [
              {
                "name": "db",
                "value": "myDb",
                "type": "path",
                "description": "Database name"
              }
            ]
          },
          "docs": "List checkpoints"
        },
        {
          "info": {
            "name": "Create checkpoint",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:5820/admin/checkpoint/:db",
            "params": [
              {
                "name": "db",
                "value": "myDb",
                "type": "path",
                "description": "Database name"
              }
            ]
          },
          "docs": "Create checkpoint"
        }
      ]
    }
  ],
  "bundled": true
}