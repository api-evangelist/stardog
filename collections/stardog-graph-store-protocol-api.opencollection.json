              {
                "name": "db",
                "value": "myDb",
                "type": "path",
                "description": "Database name"
              },
              {
                "name": "graph",
                "value": "",
                "type": "query",
                "description": "IRI of the target named graph"
              },
              {
                "name": "default",
                "value": "",
                "type": "query",
                "description": "Include instead of 'graph' to operate on the default graph"
              }
            ]
          },
