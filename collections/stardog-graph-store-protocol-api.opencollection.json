      "items": [
        {
          "info": {
            "name": "GET graph",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:5820/:db",
            "params": [
              {
                "name": "db",
                "value": "myDb",
                "type": "path",
                "description": "Database name"
              },
              {
                "name": "graph",
                "value": "",
                "type": "query",
                "description": "IRI of the named graph to retrieve"
              },
              {
                "name": "default",
                "value": "",
                "type": "query",
                "description": "Include instead of 'graph' to operate on the default graph"
              }
            ]
          },
          "docs": "Retrieves an RDF payload that is a serialization of the named graph paired with the graph IRI in the database"
        },
        {
          "info": {
            "name": "POST graph",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:5820/:db",
